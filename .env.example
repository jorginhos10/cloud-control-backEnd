DB_HOST=localhost
DB_PORT=5433
DB_NAME=chefcontrol
DB_USER=chefcontrol
DB_PASSWORD=changeme

CORS_ORIGINS=http://localhost:4200

JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=480

# Shared with backend/superadmin-backEnd/.env — lets the SuperAdmin panel's
# "entrar como" action mint a login token for a restaurant owner without
# their password. Never exposed to a browser.
SUPERADMIN_SERVICE_SECRET=changeme

# Read-only access to the SuperAdmin database, for the platform-wide
# marketplace catalog curated there (marketplace_productos, marketplace_cupones).
SUPERADMIN_DB_HOST=localhost
SUPERADMIN_DB_PORT=5433
SUPERADMIN_DB_NAME=superadmin
SUPERADMIN_DB_USER=chefcontrol
SUPERADMIN_DB_PASSWORD=changeme

# Wompi (marketplace checkout). Sign up free at https://comercios.wompi.co
# (sandbox mode needs no real business docs) and grab these from
# Developers > Secrets for technical integration.
WOMPI_ENV=sandbox
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_PUBLIC_KEY=changeme
WOMPI_INTEGRITY_SECRET=changeme
WOMPI_EVENTS_SECRET=changeme
WOMPI_REDIRECT_URL=http://localhost:4200/marketplace/pedido

# Pago de suscripción por Nequi: sin integración de API, el cliente paga manualmente a esta
# llave desde su app Nequi usando el código corto que se le muestra como referencia, y el
# SuperAdmin confirma el pago a mano. Sin esta variable, el botón de Nequi queda desactivado.
# NEQUI_LLAVE=

# Google Maps Platform: predicción de direcciones en el pedido por enlace (Places API New) y dirección desde el GPS
# (Geocoding API). Sin esta llave la predicción se desactiva; la dirección desde el GPS usa OpenStreetMap.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_REGION=co
