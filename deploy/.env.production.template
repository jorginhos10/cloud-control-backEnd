# Fill in the blanks and copy this to /opt/chefcontrol-backend/.env on the EC2 instance.

DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=chefcontrol
DB_USER=REPLACE_WITH_RDS_MASTER_USER
DB_PASSWORD=REPLACE_WITH_RDS_MASTER_PASSWORD

CORS_ORIGINS=REPLACE_WITH_FRONTEND_ORIGIN

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_FRESH_GENERATED_SECRET
JWT_EXPIRE_MINUTES=480

# Must match SUPERADMIN_SERVICE_SECRET in the superadmin-backend's .env —
# generate once with the same command above and copy the same value to both.
SUPERADMIN_SERVICE_SECRET=REPLACE_WITH_FRESH_GENERATED_SECRET

# Read-only access to the SuperAdmin database (same RDS instance, database
# "superadmin"), for the platform-wide marketplace catalog curated there.
SUPERADMIN_DB_HOST=REPLACE_WITH_RDS_ENDPOINT
SUPERADMIN_DB_PORT=5432
SUPERADMIN_DB_NAME=superadmin
SUPERADMIN_DB_USER=REPLACE_WITH_RDS_USER
SUPERADMIN_DB_PASSWORD=REPLACE_WITH_RDS_PASSWORD

# Wompi (marketplace checkout). Use PRODUCTION keys here (pub_prod_/prod_...)
# from https://comercios.wompi.co, Developers > Secrets for technical integration.
WOMPI_ENV=production
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_PUBLIC_KEY=REPLACE_WITH_WOMPI_PROD_PUBLIC_KEY
WOMPI_INTEGRITY_SECRET=REPLACE_WITH_WOMPI_PROD_INTEGRITY_SECRET
WOMPI_EVENTS_SECRET=REPLACE_WITH_WOMPI_PROD_EVENTS_SECRET
WOMPI_REDIRECT_URL=REPLACE_WITH_FRONTEND_ORIGIN/marketplace/pedido
