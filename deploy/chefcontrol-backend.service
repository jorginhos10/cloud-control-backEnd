[Unit]
Description=ChefControl FastAPI backend
After=network.target

[Service]
Type=simple
User=chefcontrol
Group=chefcontrol
WorkingDirectory=/opt/chefcontrol-backend
EnvironmentFile=/opt/chefcontrol-backend/.env
ExecStart=/opt/chefcontrol-backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
